# Copiar a .env y completar. .env está en .gitignore.

# --- Milvus (docker-compose) ---
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_URI=http://localhost:19530

# --- API keys de embeddings/LLM (según el enfoque que se elija) ---
# OPENAI_API_KEY=
# VOYAGE_API_KEY=
# ANTHROPIC_API_KEY=

# --- vLLM de la universidad (servidor H200, API compatible con OpenAI) ---
# Requiere VPN GlobalProtect activa hacia 172.28.230.10 (solo HTTP, sin TLS).
# VLLM_CHAT_BASE_URL=http://172.28.230.10:12555/v1
# VLLM_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
# VLLM_EMBEDDING_BASE_URL=http://172.28.230.10:12556/v1
# VLLM_EMBEDDING_MODEL=BAAI/bge-m3
# VLLM_API_KEY=local
# VLLM_TIMEOUT=60

# --- BD de origen para scripts/sample_stratified_articles.py (MySQL uindex-db) ---
# Solo necesario si se regenera la muestra desde la base de datos original.
# DB_HOST=localhost
# DB_PORT=3310
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
