# Imagen para calcular embeddings (BETO, Nemotron VL) fuera de esta máquina.
#
# La base trae PyTorch 2.13 + CUDA 13 preinstalados, la misma versión de torch que el
# entorno `ai_env` local, para que los vectores no cambien por diferencias de versión.
# Corre igual en máquinas sin GPU (torch cae a CPU solo), pero el sentido de esta imagen
# es llevar el trabajo a un host con GPU: Nemotron VL son ~1.7 B parámetros y en CPU tarda
# horas frente a minutos en GPU.
FROM pytorch/pytorch:2.13.0-cuda13.0-cudnn9-runtime

WORKDIR /app

# Dependencias primero, para que cambiar el código no invalide la capa de instalación.
# torch ya viene en la imagen base y no está en requirements.txt, así que no se reinstala.
# transformers>=4.56 lo exige el código remoto de llama-nemotron-embed-vl-1b-v2.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir "sentence-transformers>=3.0" "transformers>=4.56"

COPY src/ src/
COPY scripts/ scripts/

# `data/` y la caché de HuggingFace se montan como volúmenes (ver docker-compose.yml):
# los pesos del modelo pesan ~3.4 GB y no deben quedar dentro de la imagen.
ENV HF_HOME=/cache/huggingface \
    PYTHONUNBUFFERED=1

CMD ["python", "scripts/embed_nemotron.py"]
